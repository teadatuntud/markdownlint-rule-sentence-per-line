#!/usr/bin/env bash
#
# run - check the sentence-per-line rule against every fixture here.
#
# Each subdirectory holds a fixtures.md and the .markdownlint-cli2.jsonc that
# configures the rule for it. The rule must report exactly the lines that
# contain the word FLAGME.

set -u

root=$(dirname "$(readlink -f "$0")")

command -v markdownlint-cli2 >/dev/null 2>&1 || {
  printf 'run: markdownlint-cli2 not found; run npm install, then npm test\n' >&2
  exit 1
}

status=0

for case_dir in "$root"/*/; do
  name=$(basename "$case_dir")
  cd "$case_dir" || exit 1

  expected=$(grep -n FLAGME fixtures.md | cut -d: -f1 | sort -n -u)
  actual=$(markdownlint-cli2 fixtures.md 2>&1 |
    sed -n 's/^fixtures\.md:\([0-9]*\).*/\1/p' | sort -n -u)

  if [ "$expected" = "$actual" ]; then
    printf 'ok      %s: %s lines flagged, as expected\n' \
      "$name" "$(printf '%s\n' "$expected" | grep -c .)"
    continue
  fi

  status=1
  printf 'FAIL    %s: reported lines differ from the FLAGME markers\n' "$name" >&2
  diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") \
    --label expected --label actual >&2
  printf '\nFull output:\n' >&2
  markdownlint-cli2 fixtures.md >&2
done

exit "$status"
